{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "renderdemo.json",
	"version": "1.1.0",
	"type": "object",
	"properties": {
		"renderdemo": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					},
					"source": {
						"$ref": "util.json#/$defs/source"
					},
					"entry": {
						"$ref": "entry.json"
					}
				},
				"required": [
					"name",
					"source",
					"entry"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"renderdemo"
	],
	"additionalProperties": false
}